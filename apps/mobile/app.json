{
  "expo": {
    "name": "DUIT 2026",
    "slug": "duit-cards-2025",
    "scheme": "duitpilot",
    "version": "4.6.0",
    "orientation": "portrait",
    "icon": "./assets/pilot-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/pilot-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.duit.ecards.pilot"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/pilot-adaptive.png",
        "backgroundColor": "#163D35"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "io.duit.ecards.pilot",
      "versionCode": 2026091810,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "DUIT uses your microphone when you choose to record a private meeting note."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a portrait or business card to use in DUIT.",
          "cameraPermission": "Use your camera to capture a business card."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a DUIT QR code or capture a business card.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attach your current place to a meeting when you choose. Location is optional and private."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "b57ffffc-8706-4224-8036-ff3774883cb6"
      }
    },
    "owner": "prakhar"
  }
}
