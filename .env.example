# Copying is optional: npm run setup:pilot generates private .env.local values.
# Never use the restored legacy database for this pilot.
DATABASE_URL=postgresql://duit@127.0.0.1:5432/duit_2026_pilot
TEST_DATABASE_URL=postgresql://duit@127.0.0.1:5432/duit_2026_pilot_test
JWT_SECRET=generate-a-random-private-secret-with-setup-pilot
PORT=48152
PUBLIC_WEB_ORIGIN=http://localhost:48152
API_PUBLIC_ORIGIN=http://localhost:48152
APP_ORIGIN=http://localhost:48152,http://127.0.0.1:48152,http://localhost:48153,http://localhost:48151
LOCAL_OUTBOX=true
PILOT_INVITE_CODE=
PILOT_SEED_PASSWORD=generate-a-private-password-with-setup-pilot
OPENAI_API_KEY=
DUIT_AI_ENABLED=false
DUIT_AI_BUDGET_APPROVED_USD=0
DUIT_AI_IMAGE_ENABLED=false
# Optional local settings; launcher recomputes LAN origins each time it starts.
# MEDIA_DIR=/absolute/path/duit-cards-2025/.local/media
# DUIT_API_PORT=48152
# DUIT_WEB_PORT=48153
# DUIT_MOBILE_PORT=48151
# DUIT_LAN_HOST=192.168.1.20
